{
  "name": "codeg-ui-bridge",
  "version": "0.2.0",
  "private": false,
  "description": "UI-to-code bridge for Codeg",
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "codeg",
    "browser-extension",
    "ui-runtime",
    "source-binding"
  ],
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build:browser-extension": "pnpm --filter @codeg-ui-bridge/browser-extension build",
    "dev:react-demo": "pnpm --filter @codeg-ui-bridge/react-vite-demo dev",
    "lint": "echo 'lint not configured yet'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
